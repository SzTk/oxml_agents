# Copy this file to .env and edit as needed.
# CLI args take precedence over these values.

# Local llamafile backend
# MODEL_ID=llamafile:Qwen3.5-0.8B-Q8_0
# API_BASE=http://localhost:8080
# API_KEY=whatever

# Cloudflare Agent Worker relay (Anthropic-compatible /v1/messages)
MODEL_ID=anthropic:claude-sonnet-4-5
API_BASE=https://claude-workshop-relay.eyeofjapetus.workers.dev
API_KEY=<your-relay-api-key>

# Required by agent_brave.py. Free tier key: https://brave.com/search/api/
BRAVE_API_KEY=
